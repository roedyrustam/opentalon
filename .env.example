# OpenTalon Environment Configuration
# Default LLM Provider: gemini | openai
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# OpenAI API (Optional)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# OpenTalon Database (Local libSQL / Turso)
# Local: file:./opentalon.db
# Cloud: libsql://your-db.turso.io?authToken=your-token
TALON_DB_PATH=file:./opentalon.db

# Gateway & Server
TALON_PORT=8420
TALON_HOST=127.0.0.1
TALON_API_KEY=
