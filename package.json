{
  "name": "opentalon-monorepo",
  "version": "0.5.0",
  "private": true,
  "description": "OpenTalon - Sovereign Self-Evolving AI Agent Framework combining OpenClaw multi-channel gateway, Hermes 3-tier memory, Zero-Trust VM Sandbox, and Gemini Agent Booster 5-Pillar FinOps Engine",
  "keywords": [
    "ai-agent",
    "autonomous-agents",
    "gemini",
    "gemini-agent-booster",
    "mcp",
    "model-context-protocol",
    "openclaw",
    "hermes-agent",
    "multi-agent-swarm",
    "zero-trust-sandbox",
    "self-evolving-agent",
    "kv-cache",
    "finops",
    "libsql",
    "vector-rag",
    "typescript"
  ],
  "author": "Roedy Rustam <roedyrustam.id@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/opentalon.git"
  },
  "homepage": "https://github.com/roedyrustam/opentalon#readme",
  "bugs": {
    "url": "https://github.com/roedyrustam/opentalon/issues"
  },
  "type": "module",
  "scripts": {
    "talon": "node packages/cli/dist/index.js",
    "build": "pnpm -r --filter=!talon run build && pnpm --filter=talon run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@11.21.0"
}
