{
  "name": "@opentalon/memory",
  "version": "0.1.0",
  "description": "Unified libSQL/SQLite storage engine with FTS5 BM25 search, vector cosine embeddings, and Reciprocal Rank Fusion (RRF) for OpenTalon",
  "author": "Roedy Rustam <roedyrustam.id@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/opentalon.git",
    "directory": "packages/memory"
  },
  "homepage": "https://github.com/roedyrustam/opentalon#readme",
  "bugs": {
    "url": "https://github.com/roedyrustam/opentalon/issues"
  },
  "keywords": [
    "opentalon",
    "ai-agent",
    "memory",
    "libsql",
    "sqlite",
    "fts5",
    "vector-search",
    "rrf",
    "episodic-memory",
    "procedural-memory"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
